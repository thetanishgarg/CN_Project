PROJECT_DOMAIN="team1.test"

# ─── ACTUAL LAN IPs (collected via ipconfig getifaddr en0) ───
# All Macs must be on the SAME Wi-Fi / hotspot network
#
# Mac 1 – Primary DNS Server (dnsmasq)
MAC1_IP="10.128.29.224"
# Mac 2 – nginx HTTPS Edge / Primary Load Balancer  ← UPDATE with real IP
MAC2_IP="10.102.29.224"
# Mac 3 – Backend A (:3001) + Standby nginx Edge     ← UPDATE with real IP
MAC3_IP="10.128.29.70"
# Mac 4 – Backend B (:3002) + Backup DNS             ← UPDATE with real IP
MAC4_IP="10.128.29.68"

# ─── PHASE 2 VARIABLES ─────────────────────────────────────
# Ext A: Backup DNS runs on Mac 4 (same start-dns.sh, same records)
BACKUP_DNS_IP="$MAC4_IP"

# Ext E: Standby nginx edge runs on Mac 3
STANDBY_EDGE_IP="$MAC3_IP"

# Short TTL for Phase 2 Ext B/E demos (seconds)
DNS_TTL="30"

# Where app/api.team1.test resolve to (normally MAC2_IP;
# temporarily changed to STANDBY_EDGE_IP during Ext E cutover)
APP_TARGET_IP="$MAC2_IP"

# ─── SERVICE PORTS ─────────────────────────────────────────
DNS_PORT="53"
BACKEND_A_PORT="3001"
BACKEND_B_PORT="3002"
HTTPS_PORT="443"
